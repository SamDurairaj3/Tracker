{
  "name": "tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Management web application for engineering work tracking.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "preview": "pnpm start",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:postgres": "node --env-file-if-exists=.env.local --import tsx --test tests/postgres/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "vinext": "1.0.0-beta.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
