# Standard Node.js app; the browser uses same-origin API routes.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Create an EMPTY PostgreSQL database first. Replace these local example values.
# This is a server-only secret: never use a NEXT_PUBLIC_ prefix for it.
DATABASE_URL=postgresql://tracker:change-me@127.0.0.1:5432/tracker
DATABASE_POOL_MAX=5

# Generate a high-entropy local secret file, keep it ignored, and point here.
# Do not use BETTER_AUTH_SECRET; Tracker intentionally requires the file form.
BETTER_AUTH_SECRET_FILE=secrets/better_auth_secret.txt

# No demo data is inserted by startup or migrations. Keep disabled normally.
ALLOW_DEMO_SEED=false
# Optional demo seeding additionally requires NODE_ENV=development and
# pnpm db:seed:demo --confirm-demo (see docs/architecture/postgresql.md).

# Optional native integration tests use a dedicated disposable test database.
# TEST_DATABASE_URL=postgresql://tracker:change-me@127.0.0.1:5432/tracker_test
